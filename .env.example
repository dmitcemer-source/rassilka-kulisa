# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL (agent database)
KULISA_DATABASE_URL=postgresql://kulisa:kulisa@127.0.0.1:5432/kulisa

# Listmonk admin API
LISTMONK_URL=http://127.0.0.1:9000
LISTMONK_API_USERNAME=kulisa-agent
LISTMONK_API_TOKEN=

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Sender identity
KULISA_SENDER_NAME=KULISA Talent Network
KULISA_SENDER_EMAIL=campaigns@yourdomain.com
KULISA_REPLY_TO=

# Safety switches
# Sending stays disabled until you explicitly set this to true on the
# machine that runs the agent. Approval in the DB is required in addition.
KULISA_SENDING_ENABLED=false
KULISA_TEST_MODE=true

# Optional: IMAP inbox for reply monitoring
KULISA_IMAP_HOST=
KULISA_IMAP_USER=
KULISA_IMAP_PASSWORD=

# Optional: require MX checks during validation (needs dnspython)
KULISA_CHECK_MX=0
